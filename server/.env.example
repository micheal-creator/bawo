# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_URL=http://localhost:4000
CLIENT_ORIGIN=*

# Postgres
DATABASE_URL=postgres://bawo:bawo@localhost:5432/bawo
DATABASE_SSL=false

# Redis (optional). Leave unset to use the in-memory presence/OTP store,
# which is fine for a single-instance test deployment.
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# OTP: dev accepts code 123456 for any phone number
OTP_MODE=dev
OTP_CODE_TTL_SECONDS=300
OTP_DEV_CODE=123456

# Status lifetime in hours
STATUS_TTL_HOURS=24

# Media uploads. On Render's free plan the disk is ephemeral, so uploads are
# lost on redeploy. Point UPLOAD_DIR at a mounted disk or move to object storage.
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# WebRTC ICE. STUN alone works on most networks; TURN is required when both
# peers are behind symmetric NAT or restrictive firewalls.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
