# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_URL=http://localhost:4000
CLIENT_ORIGIN=*

# Postgres
DATABASE_URL=postgres://bawo:bawo@localhost:5432/bawo
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# OTP: dev accepts code 123456 for any phone number
OTP_MODE=dev
OTP_CODE_TTL_SECONDS=300
OTP_DEV_CODE=123456
